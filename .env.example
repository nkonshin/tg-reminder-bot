BOT_TOKEN=123456:ABC...
HER_USER_ID=111111111
ADMIN_USER_ID=222222222
# Optional extra scope check on top of the Telegram "only these chats"
# Business toggle: if set, business_message is ignored outside this chat.
# For a one-on-one Business dialog this is the same numeric id as
# HER_USER_ID above, so leave it at 0 (disabled) unless you specifically
# want the code-level check too.
# Chat the reminder half watches. 0 = every business chat from HER_USER_ID.
# IMPORTANT when the bot is connected to two accounts that share this dialog
# (yours and hers): the same message arrives once per connection, so leaving
# this at 0 creates every reminder twice. Set it to the interlocutor's user id
# (in a private chat the chat id equals that user's id, stable across
# reconnects) so only the owner-side connection is processed.
DIALOG_CHAT_ID=0
TIMEZONE=Asia/Yekaterinburg
APPLE_ID=you@icloud.com
APPLE_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
CALDAV_URL=https://caldav.icloud.com
CALENDAR_NAME=Домашний
CALENDAR_URL=
TRIGGER_STEMS=напомн,не забудь,поставь напоминание
DB_PATH=data/reminders.sqlite3

MONITOR_ENABLED=1
MONITOR_RETENTION_DAYS=30
MONITOR_MEDIA_DIR=data/media
MONITOR_MEDIA_TIMEOUT_SECONDS=30
MONITOR_EXPORT_PART_MB=48
MONITOR_CLEANUP_HOUR=4
